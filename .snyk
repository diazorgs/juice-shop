# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-MARSDB-480405:
    - '*':
        reason: >-
          Belum ada versi marsdb yang diperbaiki. Dipakai sengaja untuk
          tantangan NoSQL injection di Juice Shop. Mitigasi: input tidak
          dipercaya tidak boleh masuk ke query marsdb di produksi.
        expires: 2027-05-09T00:00:00.000Z
        created: 2026-11-09T15:34:24.974Z
  SNYK-JS-EXPRESSJWT-575022:
    - '*':
        reason: >-
          Transitif dari express-jwt@0.1.3 yang dipin sengaja untuk tantangan
          JWT Juice Shop. Upgrade ke express-jwt 6+ mengubah API dan merusak
          tantangan. Rencana: migrasi ke express-jwt 8 di fork produksi.
        expires: 2027-05-09T00:00:00.000Z
        created: 2026-11-09T15:34:29.383Z
